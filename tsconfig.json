{
  /* Root project: repo scripts, E2E tests and config files. Each workspace
   * (apps/*, packages/*) has its own tsconfig and typecheck script. */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* DOM: E2E tests hand functions to the browser (page.evaluate, init scripts) */
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  /* The contracts' Vitest config is checked here: the contracts' own program
   * stays without Node's types, since their code runs in browsers too. */
  "include": [
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "*.config.ts",
    "*.config.mjs",
    "vitest.shared.ts",
    "packages/contracts/vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "coverage", "playwright-report", "test-results"]
}
