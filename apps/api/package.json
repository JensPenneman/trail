{
  "name": "@trail/api",
  "version": "0.0.0",
  "private": true,
  "description": "Trail backend: Overland ingest endpoint, passkey auth and the dashboard API (Express 5 + PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@trail/contracts": "*",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.2.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
}
