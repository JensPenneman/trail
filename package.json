{
  "name": "trail",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted location history for the Overland GPS tracker: passkey sign-in, multiple people and devices, live dashboard and map history.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps apps/api/dist/main.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @trail/api",
    "test:e2e": "playwright test",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test",
    "prepare": "node scripts/hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@trail/contracts": "*",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "knip": "^6.39.0",
    "lefthook": "^2.1.15",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
