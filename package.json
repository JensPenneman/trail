{
  "name": "trail",
  "version": "0.6.0",
  "private": true,
  "description": "Self-hosted location history for phone trackers (Overland, OwnTracks, Traccar Client, OsmAnd, GPSLogger): passkey sign-in, multiple people and devices, live dashboard and map history.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "devc": "sh scripts/devc.sh",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps apps/api/dist/main.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present && npm run test:load",
    "test:integration": "npm run test:integration -w @trail/api",
    "test:e2e": "playwright test",
    "test:load": "node --test \"tools/load/test/*.test.mjs\"",
    "load": "node tools/load/run.mjs",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test",
    "prepare": "node scripts/hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@trail/contracts": "*",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
