{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "tests/e2e/**/*.ts",
        "*.config.{ts,mjs}",
        "tools/load/*.{mjs,js}",
        "tools/load/test/*.test.mjs"
      ],
      "project": ["scripts/**", "tests/**", "tools/**"],
      "ignoreDependencies": ["k6"]
    },
    "apps/api": {
      "entry": ["tests/**/*.ts", "*.config.ts"],
      "project": ["src/**", "tests/**"],
      "ignoreDependencies": ["pino-pretty", "@scalar/api-reference"]
    },
    "apps/web": {
      // playback/index.ts is the engine's door: nothing imports it until the History view is wired
      // to it (playback wiring, "PR B2"); remove it from this list then.
      "entry": ["tests/**/*.{ts,tsx}", "*.config.ts", "src/pages/map/history/playback/index.ts"],
      "project": ["src/**", "tests/**"]
    },
    "packages/contracts": {
      "entry": ["src/*.ts", "tests/**/*.ts"],
      "project": ["src/**", "tests/**"]
    }
  }
}
