{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // the map data fixture stays byte for byte what the workflow built (its
    // SHA256SUMS and manifest cover the files)
    "includes": [
      "**",
      "!**/package-lock.json",
      "!**/drizzle/meta",
      "!**/__snapshots__",
      "!**/tests/fixtures/mapdata"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "json": {
    "formatter": { "enabled": true }
  },
  // Markdown stays formatted by hand (wrapped prose, compact tables). Biome's
  // formatter would pad every table to aligned columns, turn the "+" that
  // starts a wrapped line into "-", and fail the CHANGELOG that release-please
  // writes on every release pull request.
  "markdown": {
    "formatter": { "enabled": false }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "recommended" },
      "security": { "preset": "recommended" },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        // Off while Biome is 2.6.2, which compares the rows of grid-template-areas
        // by their text length and reports valid areas (layout.css, .map-layout):
        // https://github.com/biomejs/biome/issues/12502. 2.6.3 counts cells; turn
        // the rule on again with it.
        "noInvalidGridAreas": "off"
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      },
      "complexity": {
        "noForEach": "error",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "apps/api/src/cli/**", "deploy/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
