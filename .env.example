# Local development — copy to .env (git-ignored) and run `npm run dev`.
# Values here override variables exported by your shell. Production settings
# live in deploy/.env.example.

# Postgres from compose.yaml (host port 54329, so it never clashes with another local Postgres)
DATABASE_URL=postgres://trail:trail@127.0.0.1:54329/trail

# API port; Vite (http://localhost:5173) proxies /api to it
PORT=8787
# The processing worker's liveness port (/health/live), next to the API's
PROCESSING_METRICS_PORT=8788

# Origin of the dashboard. Passkeys are bound to its hostname (WebAuthn RP ID).
PUBLIC_URL=http://localhost:5173
# Other origins that may use the API and passkeys (comma-separated)
ADDITIONAL_ORIGINS=http://localhost:8787

# Base URL phones post to (defaults to PUBLIC_URL). For a real phone on your
# Wi-Fi use the Mac's LAN address, e.g. http://192.168.1.20:5173
INGEST_BASE_URL=

# Who may create an account without an invite (comma-separated; `*@example.com` allowed)
SIGNUP_ALLOWLIST=you@example.com

LOG_LEVEL=debug

# Location processing (averaged, mapped and inferred levels; docs/operations.md).
# Map data comes from Overpass; leave PROCESSING_OVERPASS_URL empty during
# development to keep your test journeys off the public instance (no map data:
# the mapped level shows the averaged one).
PROCESSING_OVERPASS_URL=
# `npm run dev` runs the API in role api (it queues the processing) and a
# worker in role worker (it works it out), as deploy/compose.yaml does; it
# sets PROCESSING_ROLE itself (docs/architecture.md §3).
# PROCESSING_ENABLED=true
# PROCESSING_OVERPASS_DAILY_MB=300
# PROCESSING_OSM_TTL_DAYS=90
# PROCESSING_MAX_ACCURACY_M=150
# PROCESSING_STOP_MIN_S=180

# Satellite imagery for the map (off when empty; docs/operations.md): a MapLibre
# style URL, or a raster tile URL template with {z}, {x} and {y} plus its credit.
# MAP_STYLE_SATELLITE=
# MAP_STYLE_SATELLITE_ATTRIBUTION=
