# Trail production settings (docs/operations.md).
#
# Copy this file to deploy/.env (git-ignored), or let
# deploy/windows/new-env.ps1 do that and fill in the generated values.
# Docker Compose reads it next to compose.yaml; the app only receives the
# variables compose.yaml passes to it, never the tunnel or DNS tokens.
# Keep comments on their own lines. After a change run `docker compose up -d`:
# it recreates the containers whose settings changed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Database password for the db, app and backup services. Hexadecimal only,
# because it becomes part of the app's connection string. Generate one:
#   PowerShell (5.1 and 7):
#     $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
#   macOS / Linux:  openssl rand -hex 32
# It takes effect when the database is created on the first start. Changing it
# afterwards also needs ALTER USER (docs/operations.md, "Change the database password").
POSTGRES_PASSWORD=

# Canonical address of the dashboard. Passkeys are bound to its host name.
# LAN phase: the laptop itself (a passkey needs HTTPS or localhost).
# Public: https://trail.jenspenneman.com
PUBLIC_URL=http://localhost:8080

# Base URL the phones post to (<base>/api/overland), baked into each phone's
# setup QR code. LAN phase: the laptop's address on the home network (reserve
# it in the router). Public: leave empty to use PUBLIC_URL.
INGEST_BASE_URL=http://<laptop-lan-ip>:8080

# Who may create an account without an invite: comma-separated addresses
# and/or *@domain entries. The first account becomes the admin.
SIGNUP_ALLOWLIST=you@example.com

# ---------------------------------------------------------------------------
# App (optional; the values shown are the defaults)
# ---------------------------------------------------------------------------

# More origins that may use the dashboard and passkeys, comma-separated. Once
# PUBLIC_URL is public, keep the laptop's own address working with:
#   ADDITIONAL_ORIGINS=http://localhost:8080
ADDITIONAL_ORIGINS=

# Silent-device alerts via ntfy (empty = off), e.g. https://ntfy.sh/<secret-topic>
# ALERT_NTFY_URL=
# ALERT_NTFY_TOKEN=

# Status thresholds: a device is "live" while its last upload is at most
# LIVE_WINDOW_MINUTES old, "stale" (and alerted) after STALE_AFTER_HOURS.
# LIVE_WINDOW_MINUTES=15
# STALE_AFTER_HOURS=12

# SESSION_TTL_DAYS=30
# DEFAULT_TIMEZONE=Europe/Brussels
# LOG_LEVEL=info

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto are believed
# (Express `trust proxy`): they decide the client address of the rate limits and
# whether a request came over HTTPS. The default names the tunnel (cloudflared)
# and Caddy of this stack, at their fixed addresses on its `edge` network. Only
# change it for another proxy in front of the app.
# TRUST_PROXY=10.201.8.10, 10.201.8.11

# Several apps on one server: run behind a shared reverse proxy instead of the
# `direct`/`tunnel` profiles (deploy/compose.proxy.yaml, docs/operations.md 6C).
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml   (Windows: compose.yaml;compose.proxy.yaml)
# TRAIL_PROXY_NETWORK=proxy
# TRUST_PROXY=10.200.0.2

# Rate limits (requests per client address, uploads per device token). Behind
# Caddy on Docker Desktop, or on the LAN, every client shares one address.
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_API_PER_MINUTE=600
# RATE_LIMIT_INGEST_PER_MINUTE=300
# RATE_LIMIT_INGEST_FAILED_PER_10_MINUTES=30

# Map styles (MapLibre style JSON) and the extra origins the CSP allows for them
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# MAP_CONNECT_SRC=https://tiles.openfreemap.org

# ---------------------------------------------------------------------------
# Stack
# ---------------------------------------------------------------------------

# Image the app runs. `latest` follows main: Watchtower installs a new build
# within 5 minutes of CI publishing it. Roll back by pinning a build, e.g.
# TRAIL_IMAGE_TAG=sha-1a2b3c4 (the commit shown under Settings > About).
TRAIL_IMAGE_TAG=latest

# The database volume (external: create it once with `docker volume create
# trail-db`; Compose never deletes it). Set this only to keep using a volume of
# another name, e.g. trail_trail-db from before the volume became external.
# TRAIL_DB_VOLUME=trail-db

# Where the app listens on the laptop. 0.0.0.0 = the whole home network
# (phones on the Wi-Fi); 127.0.0.1 = this laptop only, for when every phone
# uses the public address. If you change the port, change PUBLIC_URL and
# INGEST_BASE_URL with it.
TRAIL_HTTP_BIND=0.0.0.0
TRAIL_HTTP_PORT=8080

# Exposure profiles that plain `docker compose` commands include:
# empty (LAN only), tunnel, or direct.
COMPOSE_PROFILES=

# Time zone for the backup schedule and container log times
TZ=Europe/Brussels

# Optional: Watchtower update reports, as a Shoutrrr URL, e.g.
# WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.sh/<secret-topic>

# ---------------------------------------------------------------------------
# Backups (service `backup`)
# ---------------------------------------------------------------------------

# Folder on the laptop for the daily dumps. Relative paths are relative to
# deploy/. A OneDrive folder gives an off-site copy; use forward slashes:
#   BACKUP_DIR=C:/Users/you/OneDrive/Backups/trail
BACKUP_DIR=./backups
# Days of dumps to keep
BACKUP_KEEP_DAYS=14
# The first dump of each month and of each year is also kept (monthly\,
# yearly\); 0 keeps them forever.
BACKUP_KEEP_MONTHS=12
BACKUP_KEEP_YEARS=0
# Hour of the daily dump (0-23, local time in TZ)
BACKUP_HOUR=3
# true = also dump every time the backup container starts. Without it a dump
# is made at start only when the newest one is more than a day old.
BACKUP_ON_START=false

# ---------------------------------------------------------------------------
# Profile `tunnel`: Cloudflare Tunnel (recommended way to go public)
# ---------------------------------------------------------------------------

# Token of the tunnel (Zero Trust > Networks > Tunnels > your tunnel)
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Profile `direct`: Caddy with Let's Encrypt on ports 80/443 + Cloudflare DDNS
# ---------------------------------------------------------------------------

# Public host name; Caddy requests its certificate and the DDNS updater keeps
# its DNS-only A record on the home IP address
TRAIL_DOMAIN=trail.jenspenneman.com
# Optional contact address for the Let's Encrypt account
ACME_EMAIL=
# Cloudflare API token with Zone > DNS > Edit for this zone only
CLOUDFLARE_API_TOKEN=
# IPv6 (AAAA record) is not managed; set cloudflare.trace to manage it too
# DDNS_IP6_PROVIDER=none
