# Trail's deployment variables (docs/operations.md).
#
# On Launchway these are the app's environment variables: Launchway writes
# them to deploy/.env with its own LAUNCHWAY_* variables (the commit, the
# public URL, the environment). For a local run (compose.dev.yaml), copy this
# file to deploy/.env (git-ignored). The app only receives the variables
# compose.yaml passes to it. Keep comments on their own lines.

# ---------------------------------------------------------------------------
# Production: required
# ---------------------------------------------------------------------------

# Starts the `backup` service. Production only: previews leave it empty.
COMPOSE_PROFILES=production

# Database password for the db, app and backup services. Hexadecimal only,
# because it becomes part of the app's connection string:
#   openssl rand -hex 32
# It takes effect when the database is created on the first start. Changing it
# afterwards also needs ALTER USER (docs/operations.md, "Change the database password").
POSTGRES_PASSWORD=

# Canonical address of the dashboard. Passkeys are bound to its host name.
# Empty: the address of the deployment's host name (LAUNCHWAY_PUBLIC_URL),
# which is what previews use.
PUBLIC_URL=https://trail.jenspenneman.com

# The existing database volume (create it once with `docker volume create
# trail-db`; Compose never deletes a volume it did not create). Previews
# leave it empty and get a volume of their own.
TRAIL_DB_VOLUME=trail-db

# Folder on the server for the daily dumps: absolute, as the Docker daemon
# sees it, and existing. A synced folder gives an off-site copy.
BACKUP_DIR=/absolute/path/to/backups

# Who may create an account without an invite: comma-separated addresses
# and/or *@domain entries. The first account becomes the admin.
SIGNUP_ALLOWLIST=you@example.com

# ---------------------------------------------------------------------------
# App (optional; the values shown are the defaults)
# ---------------------------------------------------------------------------

# Launchway's edge at its fixed address on its proxy network: the only proxy
# whose X-Forwarded-For and X-Forwarded-Proto are believed (Express `trust
# proxy`). They decide the client address of the rate limits and whether a
# request came over HTTPS.
# TRUST_PROXY=10.210.0.2

# Base URL the phones post to (<base>/api/overland), baked into each phone's
# setup QR code. Empty: PUBLIC_URL. An https:// base means uploads over plain
# HTTP are refused, whatever carries their token.
# INGEST_BASE_URL=

# More origins that may use the dashboard and passkeys, comma-separated
# ADDITIONAL_ORIGINS=

# Origins of web pages that may call the MCP server (/mcp) besides the two
# above, comma-separated; clients that are not browsers need nothing here
# MCP_ALLOWED_ORIGINS=

# Silent-device alerts via ntfy (empty = off), e.g. https://ntfy.sh/<secret-topic>
# ALERT_NTFY_URL=
# ALERT_NTFY_TOKEN=

# Status thresholds: a device is "live" while its last upload is at most
# LIVE_WINDOW_MINUTES old, "stale" (and alerted) after STALE_AFTER_HOURS.
# LIVE_WINDOW_MINUTES=15
# STALE_AFTER_HOURS=12

# SESSION_TTL_DAYS=30
# DEFAULT_TIMEZONE=Europe/Brussels

# How long the data access log keeps who looked at whose data, in days (a log,
# not location data, so it is pruned)
# DATA_ACCESS_RETENTION_DAYS=365
# LOG_LEVEL=info

# Rate limits (requests per client address, uploads per device token, API
# requests per API token, public share pages per client address). Overland
# sends batches; OwnTracks and the OsmAnd format (Traccar Client, OsmAnd,
# GPSLogger) one point per request, so their budget per device is larger.
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_API_PER_MINUTE=600
# RATE_LIMIT_INGEST_PER_MINUTE=300
# RATE_LIMIT_INGEST_SINGLE_PER_MINUTE=1200
# RATE_LIMIT_INGEST_FAILED_PER_10_MINUTES=30
# RATE_LIMIT_TOKEN_PER_MINUTE=600
# RATE_LIMIT_TOKEN_FAILED_PER_10_MINUTES=30
# RATE_LIMIT_PUBLIC_SHARE_PER_MINUTE=60

# Location processing: how you travelled (docs/operations.md, "Processing").
# Map data comes from OpenStreetMap through Overpass, at most the daily budget
# a day; set the URL empty for no map data (the mapped level shows averaged
# lines), or point it at an Overpass of your own. PROCESSING_ENABLED=false
# processes nothing. PROCESSING_ROLE and PROCESSING_METRICS_PORT are not set
# here: compose.yaml fixes them per service (`app`: api, which queues the
# work; `worker`: worker, which does it, with its liveness probe on 8081).
# PROCESSING_ENABLED=true
# PROCESSING_OVERPASS_URL=https://overpass-api.de/api/interpreter
# PROCESSING_OVERPASS_DAILY_MB=300
# PROCESSING_OSM_TTL_DAYS=90
# PROCESSING_MAX_ACCURACY_M=150
# PROCESSING_STOP_MIN_S=180
# One pass of the worker reads at most this many points, spanning at most this
# many hours; bigger work is split into passes first. A very large value
# restores unbounded passes.
# PROCESSING_PASS_MAX_POINTS=60000
# PROCESSING_PASS_MAX_SPAN_HOURS=36

# Map data for map matching (docs/operations.md, "Map data"): the regions'
# roads, railways and stops from OpenStreetMap, built every month and pulled
# from the registry into the volume trail-map. Comma-separated Geofabrik
# regions (belgium, netherlands, luxembourg, germany, france); set it empty
# for none. A private registry or package needs <user>:<token>, for GHCR a
# classic token with read:packages. MAP_DATA_MAX_GB is the largest build the
# worker downloads (Europe needs about 31).
# MAP_DATA_REGIONS=belgium
# MAP_DATA_REGISTRY=ghcr.io/jenspenneman/trail-mapdata
# MAP_DATA_REGISTRY_TOKEN=
# MAP_DATA_REFRESH_DAYS=30
# MAP_DATA_MAX_GB=10

# Map styles (MapLibre style JSON) and the extra origins the CSP allows for them
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# MAP_CONNECT_SRC=https://tiles.openfreemap.org

# Satellite imagery, off by default (docs/operations.md, "Satellite imagery"):
# a MapLibre style URL, or a raster tile URL template with {z}, {x} and {y}
# plus the provider's credit. Check the provider's terms first; a key in the
# URL is visible to anyone who can open the app.
# MAP_STYLE_SATELLITE=https://api.maptiler.com/maps/satellite/style.json?key=<your key>
# MAP_STYLE_SATELLITE=https://imagery.example.com/tiles/{z}/{x}/{y}.jpg
# MAP_STYLE_SATELLITE_ATTRIBUTION=Imagery © Example

# ---------------------------------------------------------------------------
# Load tests (docs/perf/README.md): previews only, never production
# ---------------------------------------------------------------------------

# true lets `trail load-fleet` create a load test's synthetic people, phones
# and sessions in this deployment's database. It still refuses anywhere but in
# a preview (LAUNCHWAY_ENVIRONMENT, which Launchway sets to production or
# preview) and in a database that holds a passkey or an account of a real
# person.
# LOAD_TEST=false

# ---------------------------------------------------------------------------
# Backups (service `backup`, production only)
# ---------------------------------------------------------------------------

# Time zone of the backup schedule
TZ=Europe/Brussels
# Days of dumps to keep
BACKUP_KEEP_DAYS=14
# The first dump of each month and of each year is also kept (monthly/,
# yearly/); 0 keeps them forever.
BACKUP_KEEP_MONTHS=12
BACKUP_KEEP_YEARS=0
# Hour of the daily dump (0-23, local time in TZ)
BACKUP_HOUR=3
# true = also dump every time the backup container starts. Without it a dump
# is made at start only when the newest one is more than a day old.
BACKUP_ON_START=false

# ---------------------------------------------------------------------------
# Local run only (compose.dev.yaml)
# ---------------------------------------------------------------------------

# Image to run instead of the commit's GHCR build; compose.dev.yaml builds it.
# For a local run also set COMPOSE_PROFILES, TRAIL_DB_VOLUME and BACKUP_DIR
# empty and PUBLIC_URL=http://localhost:8080.
# TRAIL_IMAGE=trail:dev

# A test of the worker's health check (compose.dev.yaml only; production
# never passes it): the worker beats once, then stands still, and its health
# check fails (docs/operations.md, "Local run").
# PROCESSING_TEST_STALL=true
